---
import Base from "../layouts/Base.astro";
---
<Base title="About | Boon" description="About Apiwish (Boon) — my journey and skills.">

  <header class="page-head" data-reveal="down">
    <span class="kicker"><i class="fa-solid fa-star"></i> THE OPERATOR</span>
    <h1>The Story <span class="grad-text">So Far</span></h1>
    <p id="about-text"></p>
  </header>

  <section class="section">
    <div class="container">
      <div class="chapter" data-reveal>
        <div class="chapter-num">Origin</div>
        <h2>Every constellation <em>starts with a spark.</em></h2>
      </div>
      <div class="timeline" id="timeline" data-reveal-group></div>
    </div>
  </section>

  <section class="section" style="background: linear-gradient(180deg, transparent, rgba(192,132,252,.06), transparent);">
    <div class="container text-center">
      <div class="chapter" data-reveal>
        <div class="chapter-num" style="justify-content:center;">The Arsenal</div>
        <h2>Tools of the <em>trade.</em></h2>
      </div>
      <div class="flex flex-wrap gap-3 center" id="skills" data-reveal-group></div>
    </div>
  </section>
</Base>

<script>
  import { bootSite, escapeHtml } from "../lib/site-loader";
  import type { AllData } from "../lib/types";

  bootSite((data: AllData) => {
    const about = document.getElementById("about-text");
    if (about) about.textContent = data.config.about;

    const tl = document.getElementById("timeline");
    if (tl) {
      tl.innerHTML = data.timeline.map((m) => `
        <div class="tl-node ${m.is_current ? "current" : ""}">
          <div class="tl-head">
            <span class="tl-icon"><i class="fa-solid ${escapeHtml(m.icon || "fa-star")}"></i></span>
            <div>
              <div class="tl-period">${escapeHtml(m.period_label)}</div>
              <h3>${escapeHtml(m.title)}</h3>
            </div>
          </div>
          <p>${escapeHtml(m.description)}</p>
        </div>`).join("");
    }

    const skills = document.getElementById("skills");
    if (skills) {
      const icons = ["fa-code","fa-database","fa-brain","fa-crown","fa-flask","fa-file-code","fa-puzzle-piece","fa-bolt","fa-dna","fa-gears"];
      skills.innerHTML = data.skills.map((s, i) => `<span class="skill-pill"><i class="fa-solid ${icons[i % icons.length]}"></i>${escapeHtml(s.label)}</span>`).join("");
    }
  });
</script>
