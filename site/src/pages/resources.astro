---
import Base from "../layouts/Base.astro";
---
<Base title="Resources | Boon" description="Curated file resources, downloads, and teaching materials.">

  <header class="page-head">
    <h1>File Resources</h1>
    <p class="lead muted">Download curated guides, materials, and more.</p>
  </header>

  <section class="section">
    <div class="container">
      <input
        id="search-input" type="search" placeholder="Search resources…"
        style="flex:1 1 260px; padding:14px 20px; margin-bottom:30px; border-radius:var(--radius-full); border:1px solid var(--border); background:var(--surface); color:var(--text); font-size:14px; width:100%; max-width:420px;"
      />
      <div id="resources"></div>
    </div>
  </section>
</Base>

<script>
  import { bootSite, escapeHtml } from "../lib/site-loader";
  import type { AllData, Resource } from "../lib/types";

  let resources: Resource[] = [];

  function render() {
    const wrap = document.getElementById("resources");
    if (!wrap) return;
    const query = (document.getElementById("search-input") as HTMLInputElement).value.trim().toLowerCase();
    const visible = resources.filter((r) => {
      const body = `${r.title} ${r.description} ${r.category} ${r.file_type} ${r.file_size}`.toLowerCase();
      return query.length === 0 || body.includes(query);
    });

    // Group resources by category, preserving insertion order.
    const order: string[] = [];
    const groups = new Map<string, typeof resources>();
    for (const r of visible) {
      if (!groups.has(r.category)) {
        groups.set(r.category, []);
        order.push(r.category);
      }
      groups.get(r.category)!.push(r);
    }

    if (!order.length) {
      wrap.innerHTML = `<div class="glass text-center" style="padding:30px;"><p class="muted">No resources match your search.</p></div>`;
      return;
    }

    wrap.innerHTML = order
      .map((cat) => {
        const items = groups.get(cat)!.map(
          (r) => `
            <div class="card" style="display:flex;flex-direction:column;">
              ${r.preview_url ? `<div class="card-img text-center"><img src="${escapeHtml(r.preview_url)}" alt="${escapeHtml(r.title)}" loading="lazy" style="max-height:120px;margin:0 auto;" /></div>` : `<div class="card-img text-center"><div class="chip" style="margin:auto;">${escapeHtml(r.file_type)}</div></div>`}
              <h3 class="mt-1">${escapeHtml(r.title)}</h3>
              <p class="muted" style="flex:1;">${escapeHtml(r.description)}</p>
              <div class="flex flex-wrap gap-2 mt-1">
                ${r.file_type ? `<span class="badge">${escapeHtml(r.file_type)}</span>` : ""}
                ${r.file_size ? `<span class="badge">${escapeHtml(r.file_size)}</span>` : ""}
                ${r.protected ? `<span class="badge" style="background:var(--tertiary-soft);color:var(--on-surface);"><i class="fa-solid fa-lock"></i> Protected</span>` : ""}
              </div>
              <div class="mt-2">
                ${
                  r.protected
                    ? `<button class="btn btn-secondary btn-block" data-protected data-title="${escapeHtml(r.title)}" data-file="${escapeHtml(r.file_url)}">
                        <i class="fa-solid fa-lock"></i> Download with Password
                      </button>`
                    : r.file_url
                    ? `<a class="btn btn-primary btn-block" href="${escapeHtml(r.file_url)}" download><i class="fa-solid fa-download"></i> Download</a>`
                    : `<button class="btn btn-secondary btn-block" disabled>Coming Soon</button>`
                }
              </div>
            </div>`
        );
        return `
          <section style="margin-bottom: var(--space-xl);" data-reveal="left">
            <h2 style="display:flex;align-items:center;gap:10px;"><span class="chip"><i class="fa-solid fa-folder"></i></span> ${escapeHtml(cat)} <span class="muted" style="font-size:12px;">(${items.length})</span></h2>
            <div class="resource-grid">${items.join("")}</div>
          </section>`;
      })
      .join("");

    wrap.querySelectorAll<HTMLButtonElement>("[data-protected]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const title = btn.dataset.title || "resource";
        const file = btn.dataset.file || "";
        const pin = prompt(`This resource is protected.\nEnter the password to download "${title}":`);
        if (pin === null) return;
        if (pin.trim()) {
          if (file) window.location.href = file;
          else alert("File URL not set for this resource.");
        }
      });
    });
  }

  bootSite((data: AllData) => {
    resources = data.resources;
    document.getElementById("search-input")?.addEventListener("input", render);
    render();
  });
</script>
