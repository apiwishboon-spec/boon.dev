---
import Base from "../../layouts/Base.astro";
---
<Base title="Project | Boon" description="Project details.">

  <section class="section">
    <div class="container" style="max-width: 820px;" data-reveal>
      <a class="btn btn-ghost" href="/projects"><i class="fa-solid fa-arrow-left-long"></i> All Projects</a>
      <div id="project" style="margin-top: 30px;"></div>
    </div>
  </section>
</Base>

<script>
  import { bootSite, escapeHtml } from "../../lib/site-loader";
  import { renderMarkdown } from "../../lib/format";
  import type { AllData } from "../../lib/types";

  const params = new URLSearchParams(location.search);
  const pathSlug = (location.pathname.match(/\/(?:projects|blog)\/([^/]+?)\/?$/) || [])[1];
  const id = params.get("id") || params.get("slug") || (pathSlug && pathSlug !== "view" ? pathSlug : "") || "";

  bootSite((data: AllData) => {
    const project = data.projects.find((p) => p.id === id || p.slug === id);
    const wrap = document.getElementById("project");
    if (!wrap) return;

    if (!project) {
      wrap.innerHTML = `<div class="text-center glass"><h2>Object not found</h2><p class="muted">This project may have been removed or the link is missing an id.</p><a class="btn btn-ghost mt-2" href="/projects">Back to projects</a></div>`;
      return;
    }

    const sorted = [...data.projects].sort((a, b) => (a.sort_order ?? 0) - (b.sort_order ?? 0));
    const idx = sorted.findIndex((q) => q.id === project.id);
    const prevProject = sorted[idx - 1];
    const nextProject = sorted[idx + 1];
    const navBtn = (label: string, title: string, href: string) =>
      `<a class="btn btn-ghost" style="max-width:46%;line-height:1.5;" href="${href}"><span style="display:block;font-size:11px;font-family:var(--font-mono);opacity:.7;">${label}</span>${escapeHtml(title)}</a>`;
    const prevLink = prevProject ? navBtn("← Previous", prevProject.title, `/projects/${encodeURIComponent(prevProject.slug)}`) : "";
    const nextLink = nextProject ? navBtn("Next →", nextProject.title, `/projects/${encodeURIComponent(nextProject.slug)}`) : "";

    wrap.innerHTML = `
      <h1 style="font-size:clamp(36px,5.5vw,58px);">${escapeHtml(project.title)}</h1>
      <p class="lede" style="color:var(--text-muted);font-size:20px;">${escapeHtml(project.tagline || project.description)}</p>
      <div class="tagrow" style="margin:8px 0 26px;">${(project.tech || []).map(t => `<span class="chip"><i class="fa-solid fa-tag"></i>${escapeHtml(t)}</span>`).join("")}</div>
      ${project.cover_url ? `<img src="${escapeHtml(project.cover_url)}" alt="${escapeHtml(project.title)}" style="width:100%;border-radius:20px;border:1px solid var(--border);margin-bottom:26px;box-shadow:var(--shadow-lg);" />` : ""}
      <div class="flex gap-2" style="gap:12px;margin-bottom:26px;">
        ${project.live_url ? `<a class="btn btn-primary" href="${escapeHtml(project.live_url)}" target="_blank" rel="noopener"><i class="fa-solid fa-arrow-up-right-from-square"></i> Live</a>` : ""}
        ${project.github_url ? `<a class="btn btn-ghost" href="${escapeHtml(project.github_url)}" target="_blank" rel="noopener"><i class="fa-brands fa-github"></i> Source</a>` : ""}
        <button class="btn btn-ghost" id="copy-link" type="button"><i class="fa-solid fa-link"></i> Copy link</button>
      </div>
      <div class="prose" style="border-top:1px solid var(--border);padding-top:26px;">${renderMarkdown(project.body)}</div>
      ${prevLink || nextLink ? `<nav style="display:flex;justify-content:space-between;gap:18px;margin-top:44px;">
        ${prevLink || "<span></span>"}
        ${nextLink ? `<span style="margin-left:auto;">${nextLink}</span>` : ""}
      </nav>` : ""}
    `;

    // Related missions (share at least one tech/tag)
    const related = data.projects
      .filter((q) => q.id !== project.id && (q.tech || []).some((t) => (project.tech || []).includes(t) || (project.tags || []).includes(t)))
      .slice(0, 3);
    if (related.length) {
      wrap.innerHTML += `
        <div style="margin-top:44px;">
          <h2 style="font-size:22px;margin-bottom:16px;"><i class="fa-solid fa-satellite-dish"></i> Related Missions</h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px;">
            ${related.map((q) => `
              <a class="glass" href="/projects/${encodeURIComponent(q.slug)}" style="padding:18px;border-radius:16px;text-decoration:none;color:inherit;display:block;">
                <h3 style="font-size:17px;margin:0;">${escapeHtml(q.title)}</h3>
                <p class="muted" style="font-size:13px;margin:6px 0 0;">${escapeHtml(q.tagline || "")}</p>
              </a>`).join("")}
          </div>
        </div>`;
    }
    document.title = (data.config.brand ? data.config.brand + " | " : "") + project.title;

    const ogTitle = project.title + (data.config.brand ? " | " + data.config.brand : "");
    const ogDesc = project.tagline || project.description || "";
    const ogUrl = `${location.origin}/projects/${encodeURIComponent(project.slug)}`;
    const setMeta = (sel: string, attr: string, value: string) => {
      const el = document.head.querySelector(`meta[${attr}="${sel}"]`);
      if (el) el.setAttribute("content", value);
    };
    setMeta("og:title", "property", ogTitle);
    setMeta("og:description", "property", ogDesc);
    setMeta("og:url", "property", ogUrl);
    setMeta("twitter:title", "name", ogTitle);
    setMeta("twitter:description", "name", ogDesc);
    if (project.cover_url) {
      const img = project.cover_url.startsWith("http") ? project.cover_url : location.origin + project.cover_url;
      setMeta("og:image", "property", img);
      setMeta("twitter:image", "name", img);
    }
    const canon = document.head.querySelector('link[rel="canonical"]');
    if (canon) canon.setAttribute("href", ogUrl);

    const copyBtn = document.getElementById("copy-link");
    if (copyBtn) {
      copyBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(location.href);
          copyBtn.innerHTML = '<i class="fa-solid fa-check"></i> Copied!';
        } catch {
          copyBtn.innerHTML = '<i class="fa-solid fa-xmark"></i> Copy failed';
        }
        setTimeout(() => {
          copyBtn.innerHTML = '<i class="fa-solid fa-link"></i> Copy link';
        }, 1600);
      });
    }
  });
</script>
