---
import Base from "../layouts/Base.astro";
---
<Base title="Honors | Boon" description="Hall of Fame — competitions, certificates, and milestones.">

  <header class="page-head" data-reveal="down">
    <span class="kicker"><i class="fa-solid fa-star"></i> HALL OF FAME</span>
    <h1>The <span class="grad-text">Trophy Shelf</span></h1>
    <p>Competitions, certificates, and milestones earned along the way.</p>
  </header>

  <section class="section">
    <div class="container">
      <div class="grid grid-3" id="honors" style="margin-top:20px;" data-reveal-group></div>
    </div>
  </section>
</Base>

<script>
  import { bootSite, escapeHtml } from "../lib/site-loader";
  import type { AllData } from "../lib/types";

  bootSite((data: AllData) => {
    const wrap = document.getElementById("honors");
    if (!wrap) return;
    wrap.innerHTML = data.honors.map((h) => `
      <div class="glass honor-card tilt flip-y">
        ${h.image_url ? `<img src="${escapeHtml(h.image_url)}" alt="${escapeHtml(h.alt)}" loading="lazy" />` : `<div class="h-icon"><i class="fa-solid ${escapeHtml(h.badge_icon || "fa-medal")}"></i></div>`}
        <span class="chip lift" style="margin-bottom:10px;"><i class="fa-solid ${escapeHtml(h.badge_icon || "fa-star")}"></i>${escapeHtml(h.badge_label)}</span>
        <h3 class="lift">${escapeHtml(h.title)}</h3>
        <p class="lift">${escapeHtml(h.description)}</p>
      </div>`).join("");
  });
</script>
