---
import Base from "../../layouts/Base.astro";
---
<Base title="Blog | Boon" description="Blog post.">

  <section class="section">
    <div class="container" style="max-width: 820px;" data-reveal>
      <a class="btn btn-ghost" href="/blog"><i class="fa-solid fa-arrow-left-long"></i> All Posts</a>
      <div id="post" style="margin-top: 30px;"></div>
    </div>
  </section>
</Base>

<script>
  import { bootSite, escapeHtml } from "../../lib/site-loader";
  import { renderMarkdown, formatDate, readingTime } from "../../lib/format";
  import type { AllData } from "../../lib/types";

  const params = new URLSearchParams(location.search);
  const pathSlug = (location.pathname.match(/\/(?:projects|blog)\/([^/]+?)\/?$/) || [])[1];
  const id = params.get("id") || params.get("slug") || (pathSlug && pathSlug !== "view" ? pathSlug : "") || "";

  bootSite((data: AllData) => {
    const post = data.posts.find((p) => p.id === id || p.slug === id);
    const wrap = document.getElementById("post");
    if (!wrap) return;

    if (!post) {
      wrap.innerHTML = `<div class="text-center glass"><h2>Transmission lost</h2><p class="muted">This post may have been removed.</p><a class="btn btn-ghost mt-2" href="/blog">Back to blog</a></div>`;
      return;
    }

    const sorted = [...data.posts].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
    const idx = sorted.findIndex((q) => q.id === post.id);
    const newerPost = sorted[idx - 1];
    const olderPost = sorted[idx + 1];
    const navBtn = (label: string, icon: string, href: string, align: string) =>
      `<a class="btn btn-ghost" style="max-width:46%;text-align:${align};line-height:1.5;" href="${href}"><span style="display:block;font-size:11px;font-family:var(--font-mono);opacity:.7;">${label}</span>${icon}</a>`;
    const prevLink = newerPost ? navBtn("Newer", `← ${escapeHtml(newerPost.title)}`, `/blog/${encodeURIComponent(newerPost.slug)}`, "left") : "";
    const nextLink = olderPost ? navBtn("Older", `${escapeHtml(olderPost.title)} →`, `/blog/${encodeURIComponent(olderPost.slug)}`, "right") : "";

    wrap.innerHTML = `
      <p style="font-family:var(--font-mono);color:var(--cyan);letter-spacing:.1em;">${formatDate(post.date)} · ${readingTime(post.body)} min read</p>
      <h1 style="font-size:clamp(34px,5vw,54px);">${escapeHtml(post.title)}</h1>
      <div class="tagrow" style="margin:10px 0 20px;">${(post.tags || []).map(t => `<span class="chip"><i class="fa-solid fa-tag"></i>${escapeHtml(t)}</span>`).join("")}</div>
      ${post.image_url ? `<img src="${escapeHtml(post.image_url)}" alt="${escapeHtml(post.title)}" style="width:100%;border-radius:20px;border:1px solid var(--border);margin-bottom:26px;box-shadow:var(--shadow-lg);" />` : ""}
      <button class="btn btn-ghost" id="copy-link" type="button" style="margin-bottom:20px;"><i class="fa-solid fa-link"></i> Copy link</button>
      <div class="prose">${renderMarkdown(post.body)}</div>
      ${prevLink || nextLink ? `<nav style="display:flex;justify-content:space-between;gap:18px;margin-top:44px;border-top:1px solid var(--border);padding-top:22px;">
        ${prevLink || "<span></span>"}
        ${nextLink ? `<span style="margin-left:auto;">${nextLink}</span>` : ""}
      </nav>` : ""}
    `;

    // Related posts (share at least one tag)
    const related = data.posts
      .filter((q) => q.id !== post.id && (q.tags || []).some((t) => (post.tags || []).includes(t)))
      .slice(0, 3);
    if (related.length) {
      wrap.innerHTML += `
        <div style="margin-top:44px;">
          <h2 style="font-size:22px;margin-bottom:16px;"><i class="fa-solid fa-head-side-virus"></i> Related Logs</h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px;">
            ${related.map((q) => `
              <a class="glass" href="/blog/${encodeURIComponent(q.slug)}" style="padding:18px;border-radius:16px;text-decoration:none;color:inherit;display:block;">
                <p class="muted" style="font-family:var(--font-mono);font-size:11px;margin:0 0 6px;">${formatDate(q.date)} · ${readingTime(q.body)} min</p>
                <h3 style="font-size:17px;margin:0;">${escapeHtml(q.title)}</h3>
              </a>`).join("")}
          </div>
        </div>`;
    }
    document.title = (data.config.brand ? data.config.brand + " | " : "") + post.title;

    const ogTitle = post.title + (data.config.brand ? " | " + data.config.brand : "");
    const ogDesc = post.excerpt || "";
    const ogUrl = `${location.origin}/blog/${encodeURIComponent(post.slug)}`;
    const setMeta = (sel: string, attr: string, value: string) => {
      const el = document.head.querySelector(`meta[${attr}="${sel}"]`);
      if (el) el.setAttribute("content", value);
    };
    setMeta("og:title", "property", ogTitle);
    setMeta("og:description", "property", ogDesc);
    setMeta("og:url", "property", ogUrl);
    setMeta("twitter:title", "name", ogTitle);
    setMeta("twitter:description", "name", ogDesc);
    if (post.image_url) {
      const img = post.image_url.startsWith("http") ? post.image_url : location.origin + post.image_url;
      setMeta("og:image", "property", img);
      setMeta("twitter:image", "name", img);
    }
    const canon = document.head.querySelector('link[rel="canonical"]');
    if (canon) canon.setAttribute("href", ogUrl);

    const copyBtn = document.getElementById("copy-link");
    if (copyBtn) {
      copyBtn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(location.href);
          copyBtn.innerHTML = '<i class="fa-solid fa-check"></i> Copied!';
        } catch {
          copyBtn.innerHTML = '<i class="fa-solid fa-xmark"></i> Copy failed';
        }
        setTimeout(() => {
          copyBtn.innerHTML = '<i class="fa-solid fa-link"></i> Copy link';
        }, 1600);
      });
    }
  });
</script>
