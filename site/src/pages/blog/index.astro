---
import Base from "../../layouts/Base.astro";
---
<Base title="Blog | Boon" description="Updates, notes, and project progress.">

  <header class="page-head">
    <span class="kicker"><i class="fa-solid fa-star"></i> MISSION LOG FEED</span>
    <h1>From the <span class="grad-text">Mission Log</span></h1>
    <p>Updates, notes, and project progress.</p>
  </header>

  <section class="section">
    <div class="container">
      <div class="flex gap-2" style="flex-wrap:wrap; gap:12px; margin-bottom:30px;">
        <input
          id="search-input" type="search" placeholder="Search posts…"
          style="flex:1 1 260px; padding:14px 20px; border-radius:var(--radius-full); border:1px solid var(--border); background:var(--surface); color:var(--text); font-size:14px;"
        />
        <select id="tag-filter" class="chip" style="padding:14px 20px; background:var(--surface); color:var(--text); cursor:pointer;">
          <option value="all">All tags</option>
        </select>
      </div>
      <div class="grid grid-3" id="posts"></div>
    </div>
  </section>
</Base>

<script>
  import { bootSite, escapeHtml } from "../../lib/site-loader";
  import { formatDate } from "../../lib/format";
  import type { AllData, BlogPost } from "../../lib/types";

  let posts: BlogPost[] = [];

  function render() {
    const query = (document.getElementById("search-input") as HTMLInputElement).value.trim().toLowerCase();
    const tag = (document.getElementById("tag-filter") as HTMLSelectElement).value;
    const filtered = posts.filter((p) => {
      const matchTag = tag === "all" || (p.tags || []).includes(tag);
      const body = `${p.title} ${p.excerpt} ${p.body} ${(p.tags || []).join(" ")}`.toLowerCase();
      return matchTag && (query.length === 0 || body.includes(query));
    });
    const wrap = document.getElementById("posts");
    if (!wrap) return;
    if (!filtered.length) {
      wrap.innerHTML = `<div class="glass text-center" style="grid-column:1/-1;"><p class="muted">No posts match your search.</p></div>`;
      return;
    }
    wrap.innerHTML = filtered.map((p) => `
      <a class="glass project-card" href="/blog/${encodeURIComponent(p.slug)}" style="color:inherit;text-decoration:none;">
        <div class="pc-icon"><i class="fa-solid fa-feather-pointed"></i></div>
        <p style="font-family:var(--font-mono);font-size:12px;color:var(--cyan);margin:0 0 8px;">${formatDate(p.date)}</p>
        <h3 style="font-size:20px;">${escapeHtml(p.title)}</h3>
        <p style="color:var(--text-muted);flex:1;">${escapeHtml(p.excerpt)}</p>
        <div class="tagrow">${(p.tags || []).map(t => `<span class="chip">${escapeHtml(t)}</span>`).join("")}</div>
      </a>`).join("");
  }

  bootSite((data: AllData) => {
    posts = data.posts;
    const tagFilter = document.getElementById("tag-filter") as HTMLSelectElement;
    const allTags = [...new Set(posts.flatMap((p) => p.tags || []))].sort();
    tagFilter.innerHTML = '<option value="all">All tags</option>' +
      allTags.map((t) => `<option value="${escapeHtml(t)}">${escapeHtml(t)}</option>`).join("");
    document.getElementById("search-input")?.addEventListener("input", render);
    tagFilter.addEventListener("change", render);
    render();
  });
</script>
