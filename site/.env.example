# Supabase credentials (anonymous / public key for the site)
PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# Optional: Cloudflare Web Analytics beacon token.
# Get it from Cloudflare Dashboard -> Web Analytics -> your site -> Copy JS Snippet.
# Leave empty/omitted to disable analytics.
# PUBLIC_CF_WEB_ANALYTICS_TOKEN=""
