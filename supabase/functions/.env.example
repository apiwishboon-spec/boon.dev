# Secrets required by the redeploy Edge Function.
# Set them with:
#   supabase secrets set CF_API_TOKEN=<token> CF_ACCOUNT_ID=<account> CF_PROJECT_NAME=<project>

# Cloudflare API token with "Cloudflare Pages -> Edit" permission
CF_API_TOKEN=

# Cloudflare account id (dashboard URL: https://dash.cloudflare.com/<account_id>)
CF_ACCOUNT_ID=lhsuugjzxzuweqpcrtlr

# Cloudflare Pages project name
CF_PROJECT_NAME=boon-profile